<https://codelist.commonapproach.org/EquityDeservingGroupsESDC#edg10> a cids:Characteristic ;
    org:hasName "Women (Cisgender and Transgender)" .

<https://metadata.un.org/sdg/8> a cids:Theme ;
    org:hasName "Goal 8: Decent work and economic growth" ;
    cids:hasDescription "Promote sustained, inclusive and sustainable economic growth, full and productive employment and decent work for all" .

<https://tamarack-youth.example/Outcome/YouthInStableEmployment/> a cids:Outcome ;
    org:hasName "Youth in stable employment" ;
    cids:forOrganization <https://tamarack-youth.example/Organization/Tamarack/> ;
    cids:forTheme <https://metadata.un.org/sdg/8> ;
    cids:hasDescription "Young people facing barriers find and keep stable jobs." ;
    cids:hasIndicator <https://tamarack-youth.example/Indicator/BImpactScore/>,
        <https://tamarack-youth.example/Indicator/YouthPlacedInJobs/> .

<https://tamarack-youth.example/Indicator/BImpactScore/> a cids:Indicator ;
    i72:unit_of_measure cids:scoreUnit ;
    org:hasName "B Impact Assessment score" ;
    cids:forOrganization <https://tamarack-youth.example/Organization/Tamarack/> ;
    cids:forOutcome <https://tamarack-youth.example/Outcome/YouthInStableEmployment/> ;
    cids:hasDescription "Overall B Impact Assessment score." ;
    cids:hasIndicatorReport <https://tamarack-youth.example/IndicatorReport/BImpactScore/2019>,
        <https://tamarack-youth.example/IndicatorReport/BImpactScore/2020>,
        <https://tamarack-youth.example/IndicatorReport/BImpactScore/2021>,
        <https://tamarack-youth.example/IndicatorReport/BImpactScore/2022>,
        <https://tamarack-youth.example/IndicatorReport/BImpactScore/2023>,
        <https://tamarack-youth.example/IndicatorReport/BImpactScore/2024> ;
    cids:unitDescription "Points" .

<https://tamarack-youth.example/Indicator/YouthPlacedInJobs/> a cids:Indicator ;
    i72:unit_of_measure cids:countUnit ;
    org:hasName "Youth placed in jobs" ;
    cids:forOrganization <https://tamarack-youth.example/Organization/Tamarack/> ;
    cids:forOutcome <https://tamarack-youth.example/Outcome/YouthInStableEmployment/> ;
    cids:forTheme <https://metadata.un.org/sdg/8> ;
    cids:hasDescription "Number of program participants who started a job lasting at least three months." ;
    cids:hasIndicatorReport <https://tamarack-youth.example/IndicatorReport/YouthPlacedInJobs/2019>,
        <https://tamarack-youth.example/IndicatorReport/YouthPlacedInJobs/2020>,
        <https://tamarack-youth.example/IndicatorReport/YouthPlacedInJobs/2021>,
        <https://tamarack-youth.example/IndicatorReport/YouthPlacedInJobs/2022>,
        <https://tamarack-youth.example/IndicatorReport/YouthPlacedInJobs/2023>,
        <https://tamarack-youth.example/IndicatorReport/YouthPlacedInJobs/2024> ;
    cids:unitDescription "Youth" .

<https://tamarack-youth.example/Organization/Tamarack/> a cids:Organization ;
    org:hasID <https://tamarack-youth.example/OrganizationID/Tamarack/> ;
    cids:hasAddress <https://tamarack-youth.example/Address/Tamarack/> ;
    cids:hasIndicator <https://tamarack-youth.example/Indicator/BImpactScore/>,
        <https://tamarack-youth.example/Indicator/YouthPlacedInJobs/> ;
    cids:hasOutcome <https://tamarack-youth.example/Outcome/YouthInStableEmployment/> ;
    sff:hasOrganizationProfile <https://tamarack-youth.example/OrganizationProfile/Tamarack/2025/> .

