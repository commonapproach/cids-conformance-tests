<https://codelist.commonapproach.org/EquityDeservingGroupsESDC#edg10> a cids:Characteristic ;
    org:hasName "Women (Cisgender and Transgender)" .

<https://harbourlight-health.example/Outcome/FewerHospitalDays/> a cids:Outcome ;
    org:hasName "Fewer avoidable hospital days" ;
    cids:forOrganization <https://harbourlight-health.example/Organization/Harbourlight/> ;
    cids:forTheme <https://metadata.un.org/sdg/3> ;
    cids:hasDescription "Patients get care at home instead of waiting in hospital." ;
    cids:hasIndicator <https://harbourlight-health.example/Indicator/HospitalDaysAvoided/>,
        <https://harbourlight-health.example/Indicator/PatientsSupported/> .

<https://metadata.un.org/sdg/3> a cids:Theme ;
    org:hasName "Goal 3: Good health and well-being" ;
    cids:hasDescription "Ensure healthy lives and promote well-being for all at all ages" .

<https://harbourlight-health.example/Indicator/HospitalDaysAvoided/> a cids:Indicator ;
    i72:unit_of_measure cids:dayUnit ;
    org:hasName "Hospital days avoided" ;
    cids:forOrganization <https://harbourlight-health.example/Organization/Harbourlight/> ;
    cids:forOutcome <https://harbourlight-health.example/Outcome/FewerHospitalDays/> ;
    cids:forTheme <https://metadata.un.org/sdg/3> ;
    cids:hasDescription "Estimated hospital bed-days avoided in the year." ;
    cids:hasIndicatorReport <https://harbourlight-health.example/IndicatorReport/HospitalDaysAvoided/2022>,
        <https://harbourlight-health.example/IndicatorReport/HospitalDaysAvoided/2023>,
        <https://harbourlight-health.example/IndicatorReport/HospitalDaysAvoided/2024> ;
    cids:unitDescription "Days" .

<https://harbourlight-health.example/Indicator/PatientsSupported/> a cids:Indicator ;
    i72:unit_of_measure cids:countUnit ;
    org:hasName "Patients supported" ;
    cids:forOrganization <https://harbourlight-health.example/Organization/Harbourlight/> ;
    cids:forOutcome <https://harbourlight-health.example/Outcome/FewerHospitalDays/> ;
    cids:forTheme <https://metadata.un.org/sdg/3> ;
    cids:hasDescription "Patients who received navigation support in the quarter." ;
    cids:hasIndicatorReport <https://harbourlight-health.example/IndicatorReport/PatientsSupported/2024-Q1>,
        <https://harbourlight-health.example/IndicatorReport/PatientsSupported/2024-Q2>,
        <https://harbourlight-health.example/IndicatorReport/PatientsSupported/2024-Q3>,
        <https://harbourlight-health.example/IndicatorReport/PatientsSupported/2024-Q4>,
        <https://harbourlight-health.example/IndicatorReport/PatientsSupported/2025-Q1>,
        <https://harbourlight-health.example/IndicatorReport/PatientsSupported/2025-Q2>,
        <https://harbourlight-health.example/IndicatorReport/PatientsSupported/2025-Q3> ;
    cids:unitDescription "Patients" .

<https://harbourlight-health.example/Organization/Harbourlight/> a cids:Organization ;
    org:hasID <https://harbourlight-health.example/OrganizationID/Harbourlight/> ;
    org:hasLegalName "Harbourlight Health Navigation Inc." ;
    cids:hasAddress <https://harbourlight-health.example/Address/Harbourlight/> ;
    cids:hasIndicator <https://harbourlight-health.example/Indicator/HospitalDaysAvoided/>,
        <https://harbourlight-health.example/Indicator/PatientsSupported/> ;
    cids:hasOutcome <https://harbourlight-health.example/Outcome/FewerHospitalDays/> ;
    sff:hasOrganizationProfile <https://harbourlight-health.example/OrganizationProfile/Harbourlight/2025/> .

