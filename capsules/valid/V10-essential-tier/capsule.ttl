<https://impact-standards-council.example/Organization/ISC/> a cids:Organization,
        cids:StandardsOrganization ;
    org:hasLegalName "Impact Standards Council (fictional)" .

<https://metadata.un.org/sdg/2> a cids:Theme ;
    org:hasName "Goal 2: Zero hunger" ;
    cids:hasDescription "End hunger, achieve food security and improved nutrition and promote sustainable agriculture" .

<https://metadata.un.org/sdg/8> a cids:Theme ;
    org:hasName "Goal 8: Decent work and economic growth" ;
    cids:hasDescription "Promote sustained, inclusive and sustainable economic growth, full and productive employment and decent work for all" .

<https://harbourlight-kitchens.example/Outcome/ImprovedFoodSecurity/> a cids:Outcome ;
    org:hasName "Improved food security for neighbours" ;
    cids:forOrganization <https://harbourlight-kitchens.example/Organization/Harbourlight/> ;
    cids:forTheme <https://metadata.un.org/sdg/2> ;
    cids:hasDescription "Households in the neighbourhood have reliable access to healthy meals." ;
    cids:hasImpactReport <https://harbourlight-kitchens.example/ImpactReport/ImprovedFoodSecurity/2025/> ;
    cids:hasIndicator <https://harbourlight-kitchens.example/Indicator/MealsServed/> ;
    cids:hasStakeholderOutcome <https://harbourlight-kitchens.example/StakeholderOutcome/NeighbourhoodHouseholds/ImprovedFoodSecurity/> .

