<https://harbourlight-kitchens.example/Address/Harbourlight/> a cids:Address ;
    cids:addressCountry "Canada" ;
    cids:addressLocality "Halifax" ;
    cids:addressRegion "NS" ;
    cids:postalCode "B3K 0F7" ;
    cids:streetAddress "52 Specimen Wharf Road" .

<https://harbourlight-kitchens.example/Characteristic/BarriersToEmployment/> a cids:Characteristic ;
