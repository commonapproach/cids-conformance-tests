    schema:codeValue "FSC-01" ;
    cids:definedBy <https://impact-standards-council.example/Organization/ISC/> ;
    cids:hasDescription "Identifies indicators about graduates of a recognised food-service training program." ;
    cids:hasSpecification "https://impact-standards-council.example/codes/food-service-credential"^^xsd:anyURI .

