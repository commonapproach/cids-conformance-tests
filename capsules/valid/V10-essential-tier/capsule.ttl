    cids:hasStakeholderOutcome <https://harbourlight-kitchens.example/StakeholderOutcome/TrainingParticipants/GraduatesInFoodServiceJobs/> .

<https://harbourlight-kitchens.example/Indicator/GraduatesEmployed/> a cids:Indicator ;
    i72:unit_of_measure cids:countUnit ;
    org:hasName "Graduates employed after six months" ;
    cids:definedBy <https://impact-standards-council.example/Organization/ISC/> ;
    cids:forOrganization <https://harbourlight-kitchens.example/Organization/Harbourlight/> ;
    cids:forOutcome <https://harbourlight-kitchens.example/Outcome/GraduatesInFoodServiceJobs/> ;
    cids:forTheme <https://metadata.un.org/sdg/8> ;
    cids:hasBaseline <https://harbourlight-kitchens.example/Indicator/GraduatesEmployed/hasBaseline/> ;
    cids:hasCode <https://harbourlight-kitchens.example/Code/FoodServiceCertificate/> ;
    cids:hasDescription "Program graduates who are working in food service six months after finishing the program." ;
    cids:hasIndicatorReport <https://harbourlight-kitchens.example/IndicatorReport/GraduatesEmployed/2023>,
        <https://harbourlight-kitchens.example/IndicatorReport/GraduatesEmployed/2024>,
        <https://harbourlight-kitchens.example/IndicatorReport/GraduatesEmployed/2025> ;
    cids:hasTarget <https://harbourlight-kitchens.example/Target/GraduatesEmployed/2023/>,
        <https://harbourlight-kitchens.example/Target/GraduatesEmployed/2024/>,
        <https://harbourlight-kitchens.example/Target/GraduatesEmployed/2025/> ;
