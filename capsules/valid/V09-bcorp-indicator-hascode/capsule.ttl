    cids:forOutcome <https://driftwood-gear.example/Outcome/ResponsibleBusiness/> ;
    cids:forTheme <https://metadata.un.org/sdg/12> ;
    cids:hasCode <https://cids-conformance.example/Code/BImpactAssessmentOverallScore> ;
    cids:hasDescription "Overall score from the company's B Impact Assessment (0-200 scale)." ;
    cids:hasIndicatorReport <https://driftwood-gear.example/IndicatorReport/BImpactAssessment/2021>,
