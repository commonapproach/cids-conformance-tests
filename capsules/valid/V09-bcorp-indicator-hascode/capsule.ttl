<https://driftwood-gear.example/ReportInfo/Driftwood/2025/> a sff:ReportInfo ;
    org:hasName "Driftwood Outdoor Gear Inc. impact report 2025" ;
    prov:endedAtTime "2025-12-31T23:59:59-08:00"^^xsd:dateTime ;
    prov:startedAtTime "2025-01-01T00:00:00-08:00"^^xsd:dateTime ;
    cids:forOrganization <https://driftwood-gear.example/Organization/Driftwood/> .

<https://cids-conformance.example/Code/BImpactAssessmentOverallScore> a cids:Code ;
    org:hasName "B Impact Assessment overall score" ;
    schema:codeValue "BIA-OVERALL" ;
    cids:definedBy <https://cids-conformance.example/Organization/BLab/> ;
    cids:hasDescription "The overall score a company earns on the B Impact Assessment. Scores run from 0 to 200; 80 or more is needed for B Corp certification." .

<https://cids-conformance.example/Organization/BLab/> a cids:Organization,
        cids:StandardsOrganization ;
    org:hasLegalName "B Lab" .

<https://codelist.commonapproach.org/EquityDeservingGroupsESDC#edg8> a cids:Characteristic ;
    org:hasName "Other Racialized Peoples" .

<https://codelist.commonapproach.org/PopulationServed#ps25> a cids:Characteristic ;
    org:hasName "General Population" .

