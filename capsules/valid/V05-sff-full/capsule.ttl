<https://codelist.commonapproach.org/EquityDeservingGroupsESDC#edg10> a cids:Characteristic ;
    org:hasName "Women (Cisgender and Transgender)" .

<https://metadata.un.org/sdg/13> a cids:Theme ;
    org:hasName "Goal 13: Climate action" ;
    cids:hasDescription "Take urgent action to combat climate change and its impacts" .

<https://metadata.un.org/sdg/7> a cids:Theme ;
    org:hasName "Goal 7: Affordable and clean energy" ;
    cids:hasDescription "Ensure access to affordable, reliable, sustainable and modern energy for all" .

<https://riverbend-energy.example/Outcome/AffordableCleanEnergy/> a cids:Outcome ;
    org:hasName "More affordable clean energy" ;
    cids:forOrganization <https://riverbend-energy.example/Organization/Riverbend/> ;
    cids:forTheme <https://metadata.un.org/sdg/7> ;
    cids:hasDescription "Members get renewable electricity at or below grid prices." ;
    cids:hasIndicator <https://riverbend-energy.example/Indicator/MembersServed/>,
        <https://riverbend-energy.example/Indicator/RenewableMWh/> .

<https://riverbend-energy.example/Outcome/ReducedGHGEmissions/> a cids:Outcome ;
    org:hasName "Reduced greenhouse gas emissions" ;
    cids:forOrganization <https://riverbend-energy.example/Organization/Riverbend/> ;
    cids:forTheme <https://metadata.un.org/sdg/13> ;
    cids:hasDescription "Members' homes and the local grid emit less greenhouse gas." ;
    cids:hasIndicator <https://riverbend-energy.example/Indicator/RenewableMWh/>,
        <https://riverbend-energy.example/Indicator/TonnesGHGAvoided/> .

cids:countUnit a i72:Cardinality_unit ;
    rdfs:label "Count" ;
    i72:symbol "count" .

cids:megawattHour a i72:Unit_multiplication ;
    rdfs:label "Megawatt-hour" ;
    i72:symbol "MWh" .

cids:tonne a i72:Singular_unit ;
    rdfs:label "Tonne" ;
    i72:symbol "t" .

<https://riverbend-energy.example/Indicator/MembersServed/> a cids:Indicator ;
    i72:unit_of_measure cids:countUnit ;
    org:hasName "Member households served" ;
    cids:describesPopulation <https://riverbend-energy.example/Population/MemberHouseholds> ;
    cids:forOrganization <https://riverbend-energy.example/Organization/Riverbend/> ;
    cids:forOutcome <https://riverbend-energy.example/Outcome/AffordableCleanEnergy/> ;
    cids:forTheme <https://metadata.un.org/sdg/7> ;
    cids:hasDescription "Households buying electricity through the co-op at year end." ;
    cids:hasIndicatorReport <https://riverbend-energy.example/IndicatorReport/MembersServed/2019>,
        <https://riverbend-energy.example/IndicatorReport/MembersServed/2020>,
        <https://riverbend-energy.example/IndicatorReport/MembersServed/2021>,
        <https://riverbend-energy.example/IndicatorReport/MembersServed/2022>,
        <https://riverbend-energy.example/IndicatorReport/MembersServed/2023>,
        <https://riverbend-energy.example/IndicatorReport/MembersServed/2024>,
        <https://riverbend-energy.example/IndicatorReport/MembersServed/2025> ;
    cids:unitDescription "Households" .

