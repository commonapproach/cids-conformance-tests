<https://lakeshore-repair.example/Outcome/LessWaste/> a cids:Outcome ;
    org:hasName "Fewer items thrown away" ;
    cids:forOrganization <https://lakeshore-repair.example/Organization/Lakeshore/> ;
    cids:forTheme <https://metadata.un.org/sdg/12> ;
    cids:hasDescription "Broken items are repaired instead of replaced." ;
    cids:hasIndicator <https://lakeshore-repair.example/Indicator/ItemsRepaired/> .

<https://metadata.un.org/sdg/1> a cids:Theme ;
    org:hasName "Goal 1: No poverty" ;
    cids:hasDescription "End poverty in all its forms everywhere" .

<https://metadata.un.org/sdg/12> a cids:Theme ;
    org:hasName "Goal 12: Responsible consumption and production" ;
    cids:hasDescription "Ensure sustainable consumption and production patterns" .

<https://silverbirch-family.example/Outcome/StableHousing/> a cids:Outcome ;
    org:hasName "Families in stable housing" ;
    cids:forOrganization <https://silverbirch-family.example/Organization/Silverbirch/> ;
    cids:forTheme <https://metadata.un.org/sdg/1> ;
    cids:hasDescription "Families at risk of eviction keep their homes." ;
    cids:hasIndicator <https://silverbirch-family.example/Indicator/FamiliesSupported/> .

<https://codelist.commonapproach.org/EquityDeservingGroupsESDC#edg10> a cids:Characteristic ;
    org:hasName "Women (Cisgender and Transgender)" .

<https://lakeshore-repair.example/Indicator/ItemsRepaired/> a cids:Indicator ;
    i72:unit_of_measure cids:countUnit ;
    org:hasName "Items repaired" ;
    cids:forOrganization <https://lakeshore-repair.example/Organization/Lakeshore/> ;
    cids:forOutcome <https://lakeshore-repair.example/Outcome/LessWaste/> ;
    cids:forTheme <https://metadata.un.org/sdg/12> ;
    cids:hasDescription "Household items repaired at repair events." ;
    cids:hasIndicatorReport <https://lakeshore-repair.example/IndicatorReport/ItemsRepaired/FY2022-23>,
        <https://lakeshore-repair.example/IndicatorReport/ItemsRepaired/FY2023-24>,
        <https://lakeshore-repair.example/IndicatorReport/ItemsRepaired/FY2024-25> ;
    cids:unitDescription "Items" .

<https://silverbirch-family.example/Indicator/FamiliesSupported/> a cids:Indicator ;
    i72:unit_of_measure cids:countUnit ;
    org:hasName "Families supported" ;
    cids:forOrganization <https://silverbirch-family.example/Organization/Silverbirch/> ;
    cids:forOutcome <https://silverbirch-family.example/Outcome/StableHousing/> ;
    cids:forTheme <https://metadata.un.org/sdg/1> ;
    cids:hasDescription "Families who received a housing support plan." ;
    cids:hasIndicatorReport <https://silverbirch-family.example/IndicatorReport/FamiliesSupported/FY2022-23>,
        <https://silverbirch-family.example/IndicatorReport/FamiliesSupported/FY2023-24>,
        <https://silverbirch-family.example/IndicatorReport/FamiliesSupported/FY2024-25> ;
    cids:unitDescription "Families" .

