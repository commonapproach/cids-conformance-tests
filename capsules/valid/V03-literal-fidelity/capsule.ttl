@prefix cids: <https://ontology.commonapproach.org/cids#> .
@prefix i72: <http://ontology.eil.utoronto.ca/ISO21972/iso21972#> .
@prefix org: <http://ontology.eil.utoronto.ca/tove/organization#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ruisseau-vert.example/Address/RuisseauVert/> a cids:Address ;
    cids:addressCountry "Canada" ;
    cids:addressLocality "Trois-Rivières" ;
    cids:addressRegion "QC" ;
    cids:postalCode "G9A 0A1" ;
    cids:streetAddress "1200, rue de l’Exemple" .

<https://ruisseau-vert.example/IndicatorReport/EnergyChange/2022> a cids:IndicatorReport ;
    i72:value [ a i72:Measure ;
            i72:hasNumericalValue "-3.5" ;
            i72:unit_of_measure cids:percentUnit ] ;
    org:hasName "Change in energy use2022" ;
    prov:endedAtTime "2022-12-31T23:59:59-05:00"^^xsd:dateTime ;
    prov:startedAtTime "2022-01-01T00:00:00-05:00"^^xsd:dateTime ;
    cids:forIndicator <https://ruisseau-vert.example/Indicator/EnergyChange/> ;
    cids:forOrganization <https://ruisseau-vert.example/Organization/RuisseauVert/> .

