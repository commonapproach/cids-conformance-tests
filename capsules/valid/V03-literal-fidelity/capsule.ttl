<https://metadata.un.org/sdg/11> a cids:Theme ;
    org:hasName "Goal 11: Sustainable cities and communities" ;
    cids:hasDescription "Make cities and human settlements inclusive, safe, resilient and sustainable" .

<https://ruisseau-vert.example/Indicator/EnergyChange/> a cids:Indicator ;
    i72:unit_of_measure cids:percentUnit ;
    org:hasName "Change in energy use" ;
    cids:forOrganization <https://ruisseau-vert.example/Organization/RuisseauVert/> ;
    cids:forOutcome <https://ruisseau-vert.example/Outcome/AffordableHomes/> ;
    cids:forTheme <https://metadata.un.org/sdg/11> ;
    cids:hasDescription "Year-over-year change in energy use per home. Negative means less energy used." ;
    cids:hasIndicatorReport <https://ruisseau-vert.example/IndicatorReport/EnergyChange/2022>,
        <https://ruisseau-vert.example/IndicatorReport/EnergyChange/2023>,
        <https://ruisseau-vert.example/IndicatorReport/EnergyChange/2024> ;
    cids:unitDescription "Percent change" .

<https://ruisseau-vert.example/Indicator/HouseholdsHoused/> a cids:Indicator ;
    i72:unit_of_measure cids:countUnit ;
    org:hasName "Households housed " ;
    cids:forOrganization <https://ruisseau-vert.example/Organization/RuisseauVert/> ;
    cids:forOutcome <https://ruisseau-vert.example/Outcome/AffordableHomes/> ;
    cids:forTheme <https://metadata.un.org/sdg/11> ;
    cids:hasDescription "Households in co-op homes at year end. ᐃᓪᓗᐃᑦ means \"houses\" in Inuktitut." ;
    cids:hasIndicatorReport <https://ruisseau-vert.example/IndicatorReport/HouseholdsHoused/2022>,
        <https://ruisseau-vert.example/IndicatorReport/HouseholdsHoused/2023>,
        <https://ruisseau-vert.example/IndicatorReport/HouseholdsHoused/2024> ;
    cids:unitDescription "Ménages" .

<https://ruisseau-vert.example/Indicator/RentSubsidy/> a cids:Indicator ;
    i72:unit_of_measure cids:cad ;
    org:hasName "Rent subsidy paid" ;
    cids:forOrganization <https://ruisseau-vert.example/Organization/RuisseauVert/> ;
    cids:forOutcome <https://ruisseau-vert.example/Outcome/AffordableHomes/> ;
    cids:forTheme <https://metadata.un.org/sdg/11> ;
    cids:hasDescription "Le Ruisseau-Vert est une coopérative fictive créée pour les tests de conformité CIDS. This description is deliberately long so that importers which cut text at 255 or 1000 characters are caught. Le Ruisseau-Vert est une coopérative fictive créée pour les tests de conformité CIDS. This description is deliberately long so that importers which cut text at 255 or 1000 characters are caught. Le Ruisseau-Vert est une coopérative fictive créée pour les tests de conformité CIDS. This description is deliberately long so that importers which cut text at 255 or 1000 characters are caught. Le Ruisseau-Vert est une coopérative fictive créée pour les tests de conformité CIDS. This description is deliberately long so that importers which cut text at 255 or 1000 characters are caught. Le Ruisseau-Vert est une coopérative fictive créée pour les tests de conformité CIDS. This description is deliberately long so that importers which cut text at 255 or 1000 characters are caught. Le Ruisseau-Vert est une coopérative fictive créée pour les tests de conformité CIDS. This description is deliberately long so that importers which cut text at 255 or 1000 characters are caught." ;
    cids:hasIndicatorReport <https://ruisseau-vert.example/IndicatorReport/RentSubsidy/2022>,
        <https://ruisseau-vert.example/IndicatorReport/RentSubsidy/2023>,
        <https://ruisseau-vert.example/IndicatorReport/RentSubsidy/2024> ;
    cids:unitDescription "CAD" .

<https://ruisseau-vert.example/Indicator/RentToIncome/> a cids:Indicator ;
    i72:unit_of_measure cids:percentUnit ;
    org:hasName "Average rent as % of income" ;
    cids:forOrganization <https://ruisseau-vert.example/Organization/RuisseauVert/> ;
    cids:forOutcome <https://ruisseau-vert.example/Outcome/AffordableHomes/> ;
    cids:forTheme <https://metadata.un.org/sdg/11> ;
    cids:hasDescription "Average monthly rent divided by household income." ;
    cids:hasIndicatorReport <https://ruisseau-vert.example/IndicatorReport/RentToIncome/2022>,
        <https://ruisseau-vert.example/IndicatorReport/RentToIncome/2023>,
        <https://ruisseau-vert.example/IndicatorReport/RentToIncome/2024> ;
    cids:unitDescription "Percent" .

<https://ruisseau-vert.example/Outcome/AffordableHomes/> a cids:Outcome ;
    org:hasName "Logements abordables — affordable homes" ;
    cids:forOrganization <https://ruisseau-vert.example/Organization/RuisseauVert/> ;
    cids:forTheme <https://metadata.un.org/sdg/11> ;
    cids:hasDescription """Line 1: « Des logements sûrs ».
Line 2: "Safe homes" & <stable> tenancy.
	Line 3 starts with a tab.""" ;
    cids:hasIndicator <https://ruisseau-vert.example/Indicator/EnergyChange/>,
        <https://ruisseau-vert.example/Indicator/HouseholdsHoused/>,
        <https://ruisseau-vert.example/Indicator/RentSubsidy/>,
        <https://ruisseau-vert.example/Indicator/RentToIncome/> .

<https://ruisseau-vert.example/Organization/RuisseauVert/> a cids:Organization ;
    org:hasLegalName "Coopérative d’habitation du Ruisseau-Vert" ;
    cids:hasAddress <https://ruisseau-vert.example/Address/RuisseauVert/> ;
    cids:hasIndicator <https://ruisseau-vert.example/Indicator/EnergyChange/>,
        <https://ruisseau-vert.example/Indicator/HouseholdsHoused/>,
        <https://ruisseau-vert.example/Indicator/RentSubsidy/>,
        <https://ruisseau-vert.example/Indicator/RentToIncome/> ;
    cids:hasOutcome <https://ruisseau-vert.example/Outcome/AffordableHomes/> .

